PORT=8787

# 飞书开放平台应用凭证，由客户企业自建应用提供
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 飞书事件订阅校验。未启用可先留空，联调时按客户应用后台填写。
FEISHU_VERIFICATION_TOKEN=

# 飞书邮箱发件人。联调后填写客户提供的公用邮箱或邮箱 ID。
FEISHU_SENDER_MAILBOX_ID=
FEISHU_SENDER_DISPLAY_NAME=BOM释放通知
FEISHU_USER_TOKEN_B64=
FEISHU_SYNC_CHAT_ID=

# 飞书邮箱用户授权持久化。生产环境推荐使用 Upstash，避免 Render 重启后丢失授权。
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
UPSTASH_FEISHU_USER_TOKEN_KEY=feishu:user-token

# 试运行限制。true 时只允许发送到 TEST_RECIPIENTS 中的邮箱。
SAFE_TEST_MODE=true
EMAIL_DRY_RUN=true
INCLUDE_FACTORY_RECIPIENTS=true
FACTORY_RECIPIENTS=迪比科=zenglinggui@dbk.com.hk;奥海=yuanyuelin@aohai.com;宣创=tsa-mc@tjc-cn.com,TSA-ENG-PE@tjc-cn.com,xie.wei-wei@tjc-cn.com,linda.gui@tjc-cn.com,chen.jing@tjc-cn.com,TSA-QA@tjc-cn.com
CONTACT_EMAIL_MAP=飞书用户ID=邮箱;飞书用户ID=邮箱
RECIPIENT_CONFIG_BITABLE=appToken|tableId|邮件收件人配置
READY_STATUS_VALUES=已通过,审批通过,完成,已完成,已发布
FIXED_RECIPIENTS=
TEST_RECIPIENTS=

# Optional polling fallback for Bitable records.
BITABLE_APP_TOKEN=
BITABLE_TABLE_ID=
BITABLE_SOURCES=
BITABLE_TRIGGER_SOURCE_NAMES=正式表1
BITABLE_LOOKUP_SOURCE_NAMES=正式表2
BITABLE_SKIP_EXISTING_ON_START=false

# Approval delivery recovery. The first run only covers the recent window;
# following runs continue from a durable Redis checkpoint with an overlap.
FEISHU_BOM_APPROVAL_CODES=
FEISHU_BOM_APPROVAL_NAMES=BOM_RELEASE_APPROVAL
APPROVAL_SYNC_LOOKBACK_MINUTES=720
APPROVAL_QUERY_START_LOOKBACK_MINUTES=525600
APPROVAL_RECOVERY_OVERLAP_MINUTES=120
APPROVAL_QUERY_MAX_PAGES=1000
APPROVAL_QUERY_RETRY_ATTEMPTS=3
APPROVAL_AUTO_SYNC_ENABLED=true
APPROVAL_INTERNAL_SYNC_INTERVAL_MINUTES=5
APPROVAL_STARTUP_SYNC_DELAY_SECONDS=10
APPROVAL_SYNC_STALE_MINUTES=20
